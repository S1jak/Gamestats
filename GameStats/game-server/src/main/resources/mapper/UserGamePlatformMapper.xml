<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lxw.gamestats.mapper.UserGamePlatformMapper">

    <!-- 查询用户在某款游戏上的平台拥有情况 -->
    <select id="listVOsByUserIdAndGameId" resultType="com.lxw.pojo.vo.PlatformVO">
        SELECT name, owned
        FROM user_game_platforms
        WHERE user_id = #{userId} AND game_id = #{gameId}
        ORDER BY id
    </select>

</mapper>
